# FreshEye 环境变量配置模板
# 复制本文件为 .env 并填写实际值
# 注意：部署版本（deploy/ 目录）仅使用 CNN 推理，不需要 LLM 配置。

# ==================== 工作流（可选，完整版需要） ====================

# OpenAI-compatible 大模型接口密钥（可选，部署版本不需要 LLM）
OPENAI_API_KEY=

# OpenAI-compatible 服务地址（支持 Ark/OpenAI/Ollama/vLLM 等；可选，部署版本不需要）
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1

# ==================== 模型服务（可选） ====================
# 未配置时工作流跳过专用模型服务

# FishFreshNetV1 模型推理服务地址
FISHFRESHNET_API_URL=https://your-fishfreshnet-api.example

# Grad-CAM 可视化服务地址（通常与 FISHFRESHNET_API_URL 相同；留空时自动回退）
MODEL_SERVICE_URL=https://your-fishfreshnet-api.example

# FishFreshNetV1 权重文件路径（留空时按默认顺序查找）
FISHFRESHNET_MODEL_PATH=

# ==================== LLM 配置（可选） ====================

# 默认 LLM 模型 ID（当节点 config JSON 中未指定 model 时使用）
FISH_AGENT_DEFAULT_MODEL=

# LLM 请求超时（秒）
FISH_AGENT_LLM_TIMEOUT=60

# LLM 请求重试次数
FISH_AGENT_LLM_RETRIES=3

# ==================== 服务配置（可选） ====================

# 项目工作区路径；留空时自动使用当前源码根目录
FISH_AGENT_WORKSPACE=

# 服务绑定地址（默认 127.0.0.1，设为 0.0.0.0 可对外暴露）
HOST=127.0.0.1

# 工作流 HTTP 服务端口
PORT=5000

# CORS 允许的来源（逗号分隔，留空则不启用 CORS 跨域）
CORS_ORIGINS=

# 日志级别：DEBUG / INFO / WARNING / ERROR
FISH_AGENT_LOG_LEVEL=INFO

# 模型服务上传图片大小上限（MB）
FISHFRESHNET_MAX_IMAGE_MB=25
